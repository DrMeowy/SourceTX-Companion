<Window x:Class="SourceTXCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SourceTX Companion" 
        Height="580" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" /> <!-- Custom Title Bar -->
            <RowDefinition Height="*" />  <!-- Main Content Views -->
            <RowDefinition Height="34" /> <!-- Bottom Status Bar with Bug Report -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. CUSTOM TITLE BAR                        -->
        <!-- ========================================== -->
        <Border Grid.Row="0" 
                Background="{DynamicResource TitleBarBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,0,8,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M 12 3 L 20 8 L 20 16 L 12 21 L 4 16 L 4 8 Z" 
                              Stroke="{DynamicResource AccentBrush}" 
                              StrokeThickness="1.5" 
                              Fill="Transparent" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" 
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="SourceTX" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" Companion" FontWeight="Normal" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v0.1.2" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Minimize & Close only, Fixed Size) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlBtn}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Data="M 0 0 L 10 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="2" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseBtn}" Click="CloseButton_Click" ToolTip="Close">
                        <Path Data="M 0 0 L 9 9 M 0 9 L 9 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="9" Height="9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. MAIN CONTENT AREA (VIEWS)               -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="22,12,22,10">

            <!-- ====================================== -->
            <!-- VIEW A: HOME DASHBOARD (5 MODULES)     -->
            <!-- ====================================== -->
            <Grid x:Name="HomeView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero Section Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <TextBlock Text="SourceTX Surface Companion" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Visual Hardware Customizer, 1-Click Compiler, Flasher &amp; Surface Configurator (v1.98)" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 5 Main Action Modules: Row 1 (3 Primary), Row 2 (2 Storage) -->
                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 1: INSTALL, UPDATE, CONFIG (3 Columns) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- BUTTON 1: INSTALL (Factory Build Installation) -->
                        <Button Grid.Column="0" 
                                Style="{StaticResource ActionCardBtn}" 
                                Click="NavToInstall_Click" 
                                MinHeight="185">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" 
                                        Width="40" Height="40" 
                                        CornerRadius="10" 
                                        Background="{DynamicResource CardInstallBgBrush}" 
                                        BorderBrush="{DynamicResource CardInstallBorderBrush}" 
                                        BorderThickness="1" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,8">
                                    <Path Data="M 12 2 L 15 8 L 22 9 L 17 14 L 18 21 L 12 17 L 6 21 L 7 14 L 2 9 L 9 8 Z" 
                                          Stroke="{DynamicResource CardInstallAccentBrush}" 
                                          StrokeThickness="1.8" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round" 
                                          Width="16" Height="16" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Install" 
                                               FontSize="17" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Factory Build Installation" 
                                               FontSize="10.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource CardInstallAccentBrush}" 
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" 
                                           Text="One-click provisioning: download a signed factory release, verify hardware, erase if selected, and flash the complete image."
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="15" 
                                           Margin="0,0,0,8"/>

                                <Border Grid.Row="3" 
                                        Background="{DynamicResource CardInstallPillBrush}" 
                                        CornerRadius="6" 
                                        Padding="10,6" 
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Factory Installation" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource CardInstallAccentBrush}" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="→" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource CardInstallAccentBrush}" 
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- BUTTON 2: UPDATE (Firmware Flasher & Compiler) -->
                        <Button Grid.Column="2" 
                                Style="{StaticResource ActionCardBtn}" 
                                Click="NavToUpdate_Click" 
                                MinHeight="185">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" 
                                        Width="40" Height="40" 
                                        CornerRadius="10" 
                                        Background="{DynamicResource CardUpdateBgBrush}" 
                                        BorderBrush="{DynamicResource CardUpdateBorderBrush}" 
                                        BorderThickness="1" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,8">
                                    <Path Data="M 12 3 L 12 15 M 7 10 L 12 15 L 17 10 M 4 19 L 20 19" 
                                          Stroke="{DynamicResource CardUpdateAccentBrush}" 
                                          StrokeThickness="1.8" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round" 
                                          Width="16" Height="16" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Update" 
                                               FontSize="17" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Firmware Recovery &amp; Flasher" 
                                               FontSize="10.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource CardUpdateAccentBrush}" 
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" 
                                           Text="Flash target binaries (4MB / 8MB / 16MB) or rebuild directly from source with integrated PlatformIO Core." 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="15" 
                                           Margin="0,0,0,8"/>

                                <Border Grid.Row="3" 
                                        Background="{DynamicResource CardUpdatePillBrush}" 
                                        CornerRadius="6" 
                                        Padding="10,6" 
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Update Firmware" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource CardUpdateAccentBrush}" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="→" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource CardUpdateAccentBrush}" 
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- BUTTON 3: CONFIG (Surface Configurator & Pin Map) -->
                        <Button Grid.Column="4" 
                                Style="{StaticResource ActionCardBtn}" 
                                Click="NavToConfig_Click" 
                                MinHeight="185">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" 
                                        Width="40" Height="40" 
                                        CornerRadius="10" 
                                        Background="{DynamicResource CardConfigBgBrush}" 
                                        BorderBrush="{DynamicResource CardConfigBorderBrush}" 
                                        BorderThickness="1" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,8">
                                    <Path Data="M 4 7 L 14 7 M 18 7 L 20 7 M 14 5 L 14 9 M 4 17 L 8 17 M 12 17 L 20 17 M 8 15 L 8 19" 
                                          Stroke="{DynamicResource CardConfigAccentBrush}" 
                                          StrokeThickness="1.8" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round" 
                                          Width="16" Height="16" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Config" 
                                               FontSize="17" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Hardware Pin Map &amp; Surface Config" 
                                               FontSize="10.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource CardConfigAccentBrush}" 
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" 
                                           Text="Visual GPIO pinout mapper, 1-click compiler, steering/throttle curves, dual ESC MOA crawlers, and CRSF link." 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="15" 
                                           Margin="0,0,0,8"/>

                                <Border Grid.Row="3" 
                                        Background="{DynamicResource CardConfigPillBrush}" 
                                        CornerRadius="6" 
                                        Padding="10,6" 
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Open Configurator" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource CardConfigAccentBrush}" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="→" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource CardConfigAccentBrush}" 
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- ROW 2: EXPORT, IMPORT (2 Columns) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- BUTTON 4: EXPORT -->
                        <Button Grid.Column="0" 
                                Style="{StaticResource ActionCardBtn}" 
                                Click="NavToExport_Click" 
                                MinHeight="136" 
                                Padding="18,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardExportBgBrush}" BorderBrush="{DynamicResource CardExportBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="M 12 15 L 12 3 M 7 8 L 12 3 L 17 8 M 4 19 L 20 19" 
                                                  Stroke="{DynamicResource CardExportAccentBrush}" 
                                                  StrokeThickness="1.8" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round" 
                                                  Width="14" Height="14" 
                                                  Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Export" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Model Memory Backup (STXM)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CardExportAccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" 
                                           Text="Generate SOURCETX_MODEL: ASCII envelopes with STXM magic (0x5354584D), Schema 21, and FNV-1a checksums." 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="15" 
                                           Margin="0,0,0,6"/>

                                <Border Grid.Row="2" 
                                        Background="{DynamicResource CardExportPillBrush}" 
                                        CornerRadius="5" 
                                        Padding="10,5" 
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Export Model Backups" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CardExportAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="→" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CardExportAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- BUTTON 5: IMPORT -->
                        <Button Grid.Column="2" 
                                Style="{StaticResource ActionCardBtn}" 
                                Click="NavToImport_Click" 
                                MinHeight="136" 
                                Padding="18,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardImportBgBrush}" BorderBrush="{DynamicResource CardImportBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="M 4 4 L 4 14 C 4 17 20 17 20 14 L 20 4 M 12 4 L 12 12 M 8 8 L 12 12 L 16 8" 
                                                  Stroke="{DynamicResource CardImportAccentBrush}" 
                                                  StrokeThickness="1.8" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round" 
                                                  Width="14" Height="14" 
                                                  Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Import" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Model Memory Restore (STXM)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CardImportAccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" 
                                           Text="Inspect and validate SOURCETX_MODEL: envelopes with STXM magic, Schema 21 payload size, and FNV-1a hash." 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="15" 
                                           Margin="0,0,0,6"/>

                                <Border Grid.Row="2" 
                                        Background="{DynamicResource CardImportPillBrush}" 
                                        CornerRadius="5" 
                                        Padding="10,5" 
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Import &amp; Restore Models" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CardImportAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="→" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CardImportAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW B: INSTALL (FACTORY INSTALLATION) -->
            <!-- ====================================== -->
            <Grid x:Name="InstallView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}" 
                            HorizontalAlignment="Left" 
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Factory Build Installation &amp; Provisioning" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Install Content Deck -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Hardware Selection Row: 1. Board, 2. Display, 3. Serial Port, 4. Baud -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. Select ESP32 Board" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="InstallBoardComboBox" Height="32" SelectionChanged="HardwareTarget_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="2. Select Display Panel" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="InstallDisplayComboBox" Height="32" SelectionChanged="HardwareTarget_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Target Serial Port (ESP32 Auto-Detect)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="InstallPortComboBox" Height="32" />
                            </StackPanel>

                            <Button Grid.Column="6" 
                                    Style="{StaticResource ModernAccentButton}" 
                                    Background="#1A283C"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    Height="32" 
                                    VerticalAlignment="Bottom" 
                                    Click="AutoDetectPorts_Click"
                                    ToolTip="Auto-detect connected ESP32-S3 and scan serial devices">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Auto-Detect" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Flashing Baud" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="InstallBaudComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="115200 (PlatformIO Default)" />
                                    <ComboBoxItem Content="460800 (Standard)" />
                                    <ComboBoxItem Content="921600 (High Speed)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Dynamic Board Specs & Pinout Info Card -->
                        <Border Grid.Row="1" Background="#161F2E" BorderBrush="#253A59" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="InstallSpecsBlock" Text="Target: ESP32-S3-FH4R2 (240MHz, 4MB Flash DIO/80M, 2MB PSRAM) • 3.5&quot; ST7796U 480x320 SPI (Rot 3)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="InstallPinoutBlock" Text="Pinout: Steering GPIO 6, Throttle GPIO 5 | CRSF GPIO 42 (Single-Wire) | TFT CS 14, DC 13, MOSI 7, CLK 2" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="InstallTargetStatusBadge" Background="#1B3324" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallTargetStatusText" Text="Target Verified" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Factory Package & Provisioning Options -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Signed Factory Package (online with verified offline fallback)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBox x:Name="InstallPackagePathBox" 
                                         Text="SourceTX-Updates / factory.json (complete image @ 0x0000)"
                                         Height="32" 
                                         VerticalContentAlignment="Center" 
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,10,0,0">
                                <CheckBox x:Name="EraseChipCheckBox" IsChecked="True" Content="Full Chip Erase before flashing (erase_flash)" Margin="0,0,0,3" FontSize="11"/>
                                <TextBlock x:Name="InstallNvsLabel" Text="NVS model catalog (0x3D0000) provisioned automatically on boot" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar & Status -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <TextBlock x:Name="InstallStatusText" Text="Ready to download, verify, and install the signed factory release" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InstallPercentText" Text="0%" FontSize="10.5" FontWeight="SemiBold" Foreground="#C084FC" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="InstallProgressBar" Value="0" Maximum="100" Height="5" Foreground="#C084FC" />
                        </StackPanel>

                        <!-- Console Output Log Box -->
                        <Border Grid.Row="4" 
                                Background="#0A0C10" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8" 
                                MinHeight="75"
                                Margin="0,0,0,8">
                            <ScrollViewer x:Name="InstallLogScroll" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="InstallConsoleLogBlock" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="10" 
                                           Foreground="#C084FC" 
                                           TextWrapping="Wrap" 
                                           Text="[FACTORY] SourceTX Clean Factory Installer ready (esptool v5.3.0).&#x0a;[FACTORY] Select your ESP32 board and display panel from the dropdowns above.&#x0a;[FACTORY] Connect board via USB, click '⚡ Auto-Detect', then 'Run Factory Installation'." />
                            </ScrollViewer>
                        </Border>

                        <!-- Install Action Button -->
                        <Button Grid.Row="5" 
                                x:Name="RunInstallButton" 
                                Style="{StaticResource ModernAccentButton}" 
                                Background="#9333EA"
                                Height="34" 
                                HorizontalAlignment="Right" 
                                Click="StartInstall_Click">
                            <TextBlock Text="⚡ Run Factory Installation (0x0000)" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW C: UPDATE / FIRMWARE PANEL        -->
            <!-- ====================================== -->
            <Grid x:Name="UpdateView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}" 
                            HorizontalAlignment="Left" 
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Firmware Flasher &amp; 1-Click Compiler" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Update Content Deck -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Target Board, Display, Flashing Mode & Port Selection -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="0.75*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. ESP32 Board" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="UpdateBoardComboBox" Height="32" SelectionChanged="HardwareTarget_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="2. Display Panel" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="UpdateDisplayComboBox" Height="32" SelectionChanged="HardwareTarget_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Flashing Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="FlashModeComboBox" Height="32" SelectionChanged="FlashMode_Changed">
                                    <ComboBoxItem Content="Full Factory (0x0000)" IsSelected="True" />
                                    <ComboBoxItem Content="App (0x10000)" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Target Serial Port" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="PortComboBox" Height="32" />
                            </StackPanel>

                            <Button Grid.Column="8" 
                                    Style="{StaticResource ModernAccentButton}" 
                                    Background="#1A283C"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    Height="32" 
                                    VerticalAlignment="Bottom" 
                                    Click="AutoDetectPorts_Click"
                                    ToolTip="Auto-detect connected ESP32-S3 and scan serial devices">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Auto-Detect" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="10">
                                <TextBlock Text="Baud Rate" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="BaudComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="115200 (Default)" />
                                    <ComboBoxItem Content="460800" />
                                    <ComboBoxItem Content="921600" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Firmware File Selection & Rebuild Action -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Firmware Binary (.bin)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBox x:Name="FirmwarePathBox" 
                                         Text="SourceTX_ESP32S3_SuperMini_Factory.bin (Full Image @ 0x0000)" 
                                         Height="32" 
                                         VerticalContentAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="2" 
                                    Style="{StaticResource ModernOutlineButton}" 
                                    Height="32" 
                                    VerticalAlignment="Bottom"
                                    Click="BrowseFirmware_Click">
                                <TextBlock Text="Browse..." FontWeight="Medium" FontSize="11" />
                            </Button>

                            <Button Grid.Column="4" 
                                    Style="{StaticResource ModernAccentButton}" 
                                    Background="#1D2A3D"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    Height="32" 
                                    VerticalAlignment="Bottom"
                                    Click="RebuildFirmware_Click"
                                    ToolTip="Recompile firmware from source using integrated PlatformIO CLI">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔨 Rebuild from Source" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Progress Bar & Status -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <TextBlock x:Name="FlashStatusText" Text="Ready to flash ESP32-S3 transmitter" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="FlashPercentText" Text="0%" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="FlashProgressBar" Value="0" Maximum="100" Height="5" />
                        </StackPanel>

                        <!-- Console Output Log Box -->
                        <Border Grid.Row="3" 
                                Background="#0A0C10" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8" 
                                MinHeight="75"
                                Margin="0,0,0,8">
                            <ScrollViewer x:Name="FlashLogScroll" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ConsoleLogBlock" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="10" 
                                           Foreground="#85E89D" 
                                           TextWrapping="Wrap" 
                                           Text="[INFO] SourceTX Flasher &amp; Compiler Engine ready (PlatformIO Core 6.1.19 / esptool v5.3.0).&#x0a;[INFO] Verified Target: ESP32-S3-FH4R2 (4MB Flash, ST7796U).&#x0a;[INFO] Connect transmitter via USB and click '⚡ Flash ESP32-S3 Firmware' or '🔨 Rebuild from Source'." />
                            </ScrollViewer>
                        </Border>

                        <!-- Flash Action Button -->
                        <Button Grid.Row="4" 
                                x:Name="FlashButton" 
                                Style="{StaticResource ModernAccentButton}" 
                                Height="34" 
                                HorizontalAlignment="Right" 
                                Click="StartFlash_Click">
                            <TextBlock Text="⚡ Flash ESP32-S3 Firmware" FontWeight="Bold" FontSize="11.5" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW D: CONFIG / SETTINGS PANEL        -->
            <!-- ====================================== -->
            <Grid x:Name="ConfigView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}" 
                            HorizontalAlignment="Left" 
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Hardware Pin Mapping &amp; Surface Configurator" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Config Tabbed Interface -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Status Notice Banner -->
                        <Border Grid.Row="0" Background="#1C1F2B" BorderBrush="#303A52" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ Configuration &amp; Builder: " FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Configure hardware GPIO pinouts below and rebuild directly with PlatformIO without opening VSCode." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tab Header Switcher (5 Tabs) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="TabPinMapBtn" Style="{StaticResource ModernAccentButton}" Padding="12,6" Margin="0,0,6,0" Click="TabPinMap_Click">
                                <TextBlock Text="⚡ Hardware Pin Mapping" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="TabChannelsBtn" Style="{StaticResource ModernOutlineButton}" Padding="12,6" Margin="0,0,6,0" Click="TabChannels_Click">
                                <TextBlock Text="Surface Channels" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="TabSubsystemsBtn" Style="{StaticResource ModernOutlineButton}" Padding="12,6" Margin="0,0,6,0" Click="TabSubsystems_Click">
                                <TextBlock Text="Surface Subsystems" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="TabCrsfBtn" Style="{StaticResource ModernOutlineButton}" Padding="12,6" Margin="0,0,6,0" Click="TabCrsf_Click">
                                <TextBlock Text="CRSF &amp; Telemetry" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="TabHardwareBtn" Style="{StaticResource ModernOutlineButton}" Padding="12,6" Click="TabHardware_Click">
                                <TextBlock Text="System Preferences" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>

                        <!-- Tab Content 0: Hardware Pin Mapping & Build Engine -->
                        <ScrollViewer Grid.Row="2" x:Name="PanelPinMapTab" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Visual Hardware Pinout &amp; GPIO Mapping" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="#1B3324" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="PinValidationBadge" Text="✓ Valid Reference Pinout (ESP32-S3-FH4R2)" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Primary Controls & CRSF -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Steering ADC Wiper" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="PinSteeringBox" Height="30" SelectedIndex="5" SelectionChanged="PinSelection_Changed">
                                            <ComboBoxItem Content="GPIO 1 (ADC1_CH0)" />
                                            <ComboBoxItem Content="GPIO 2 (ADC1_CH1)" />
                                            <ComboBoxItem Content="GPIO 3 (ADC1_CH2)" />
                                            <ComboBoxItem Content="GPIO 4 (ADC1_CH3)" />
                                            <ComboBoxItem Content="GPIO 5 (ADC1_CH4)" />
                                            <ComboBoxItem Content="GPIO 6 (ADC1_CH5) [Default]" />
                                            <ComboBoxItem Content="GPIO 7 (ADC1_CH6)" />
                                            <ComboBoxItem Content="GPIO 8 (ADC1_CH7)" />
                                            <ComboBoxItem Content="GPIO 9 (ADC1_CH8)" />
                                            <ComboBoxItem Content="GPIO 10 (ADC1_CH9)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Throttle ADC Wiper" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="PinThrottleBox" Height="30" SelectedIndex="4" SelectionChanged="PinSelection_Changed">
                                            <ComboBoxItem Content="GPIO 1 (ADC1_CH0)" />
                                            <ComboBoxItem Content="GPIO 2 (ADC1_CH1)" />
                                            <ComboBoxItem Content="GPIO 3 (ADC1_CH2)" />
                                            <ComboBoxItem Content="GPIO 4 (ADC1_CH3)" />
                                            <ComboBoxItem Content="GPIO 5 (ADC1_CH4) [Default]" />
                                            <ComboBoxItem Content="GPIO 6 (ADC1_CH5)" />
                                            <ComboBoxItem Content="GPIO 7 (ADC1_CH6)" />
                                            <ComboBoxItem Content="GPIO 8 (ADC1_CH7)" />
                                            <ComboBoxItem Content="GPIO 9 (ADC1_CH8)" />
                                            <ComboBoxItem Content="GPIO 10 (ADC1_CH9)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="CRSF Single-Wire UART" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="PinCrsfBox" Height="30" SelectedIndex="0" SelectionChanged="PinSelection_Changed">
                                            <ComboBoxItem Content="GPIO 42 (UART1 Single-Wire) [Default]" />
                                            <ComboBoxItem Content="GPIO 43 (UART1 TX)" />
                                            <ComboBoxItem Content="GPIO 44 (UART1 RX)" />
                                            <ComboBoxItem Content="GPIO 17" />
                                            <ComboBoxItem Content="GPIO 18" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Display SPI Bus -->
                                <TextBlock Text="ST7796U Display SPI Bus &amp; Backlight" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" Margin="0,2,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MOSI" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 7" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SCLK" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 2" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="CS" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 14" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="DC" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 13" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="RST" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 10" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="10">
                                        <TextBlock Text="Backlight" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 3" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Touch & I2C Bus -->
                                <TextBlock Text="FT6x36 Touch &amp; Sensor I2C Bus" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" Margin="0,2,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="I2C SDA (Touch/INA219)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 8 (Shared 100kHz)" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="I2C SCL (Touch/INA219)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 9 (Shared 100kHz)" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Touch Reset (RST)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 11" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Touch Interrupt (INT)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="GPIO 12" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="10.5" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab Content 1: Surface Channels -->
                        <ScrollViewer Grid.Row="2" x:Name="PanelChannelsTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Primary Surface Control Channels (Reference Pinout)" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CH1 (Steering Wheel — GPIO 6 Wiper ADC)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="0" Height="32">
                                            <ComboBoxItem Content="Steering (Standard)" />
                                            <ComboBoxItem Content="Steering (Inverted)" />
                                            <ComboBoxItem Content="Dual Rate Steering" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CH2 (Throttle / Brake — GPIO 5 Wiper ADC)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="0" Height="32">
                                            <ComboBoxItem Content="Forward / Brake / Reverse" />
                                            <ComboBoxItem Content="Forward / Reverse (Crawler Direct)" />
                                            <ComboBoxItem Content="Forward Only (Race Boat/Car)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CH3 (Aux 1 / 2-Speed Shift / Dual ESC Front)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="0" Height="32">
                                            <ComboBoxItem Content="Aux 1 (2-Speed Shift)" />
                                            <ComboBoxItem Content="Dual ESC (Front Motor)" />
                                            <ComboBoxItem Content="Winch Control" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CH4 (Aux 2 / Dig Unit / Dual ESC Rear)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="1" Height="32">
                                            <ComboBoxItem Content="Aux 2 (General)" />
                                            <ComboBoxItem Content="Dig Lock / Freewheel" />
                                            <ComboBoxItem Content="Dual ESC (Rear Motor)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab Content 2: Surface Subsystems -->
                        <ScrollViewer Grid.Row="2" x:Name="PanelSubsystemsTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Surface Tuning Subsystems" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Dual ESC MOA Crawler Mixing (%)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="1" Height="32">
                                            <ComboBoxItem Content="Disabled (Single ESC)" />
                                            <ComboBoxItem Content="50:50 Balanced MOA" />
                                            <ComboBoxItem Content="60:40 Front Bias (Climb Spec)" />
                                            <ComboBoxItem Content="70:30 Front Bias" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Neutral Drag Brake (%)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="2" Height="32">
                                            <ComboBoxItem Content="0% (Freewheel Coast)" />
                                            <ComboBoxItem Content="25% Mild Drag" />
                                            <ComboBoxItem Content="50% Crawler Hold" />
                                            <ComboBoxItem Content="100% Full Hill Hold" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab Content 3: CRSF & Telemetry -->
                        <ScrollViewer Grid.Row="2" x:Name="PanelCrsfTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="CRSF Radio Link &amp; Alarms (GPIO 42 Single-Wire)" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CRSF Packet Rate" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="2" Height="32">
                                            <ComboBoxItem Content="50 Hz" />
                                            <ComboBoxItem Content="150 Hz" />
                                            <ComboBoxItem Content="250 Hz (Default ExpressLRS)" />
                                            <ComboBoxItem Content="500 Hz (Ultra Low Latency)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Telemetry Ratio" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="1" Height="32">
                                            <ComboBoxItem Content="1:128 (Ultra Fast Control)" />
                                            <ComboBoxItem Content="1:64 (Standard Telemetry)" />
                                            <ComboBoxItem Content="1:16 (High Bandwidth Sensors)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab Content 4: System Preferences -->
                        <ScrollViewer Grid.Row="2" x:Name="PanelHardwareTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Transmitter System &amp; Display Preferences (ST7796U PWM)" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Active Model Profile Name" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="Crawler 4x4 MOA Dual ESC" Height="32" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ST7796U Backlight PWM (GPIO 3)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedIndex="3" Height="32">
                                            <ComboBoxItem Content="25%" />
                                            <ComboBoxItem Content="50%" />
                                            <ComboBoxItem Content="75%" />
                                            <ComboBoxItem Content="100% (Daylight Sunlight)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Config Action Bar with Compiler Trigger -->
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <Button Style="{StaticResource ModernOutlineButton}" Height="32" HorizontalAlignment="Left" Click="QuickExport_Click">
                                <TextBlock Text="Export Model (STXM)" FontSize="11" />
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ModernAccentButton}" 
                                        Background="#1D2A3D"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        Height="32" 
                                        Margin="0,0,8,0" 
                                        Click="RebuildFirmware_Click">
                                    <TextBlock Text="🔨 Rebuild from Source (PlatformIO)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Button>
                                <Button Style="{StaticResource ModernAccentButton}" Height="32" Click="SaveConfig_Click">
                                    <TextBlock Text="✓ Apply &amp; Save Config" FontWeight="Bold" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW E: EXPORT PANEL                   -->
            <!-- ====================================== -->
            <Grid x:Name="ExportView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}" 
                            HorizontalAlignment="Left" 
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Export Model Memory Backup (SOURCETX_MODEL)" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Export Content Deck -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Scope & Model Selection -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Export Format Contract" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="SOURCETX_MODEL (STXM Magic)" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" x:Name="ExportSlotPanel">
                                <TextBlock Text="Source Model Slot (modelnvs @ 0x3D0000)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ExportSlotComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="Slot 01: Crawler 4x4 MOA Dual ESC" />
                                    <ComboBoxItem Content="Slot 02: Drift Spec RWD Gyro" />
                                    <ComboBoxItem Content="Slot 03: Monster Truck 6S Bashing" />
                                    <ComboBoxItem Content="Slot 04: Scale Trail Boat" />
                                    <ComboBoxItem Content="Slot 05: Tracked Snow Tank" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="File Format" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ExportFormatComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="SourceTX Model Envelope (.stx)" />
                                    <ComboBoxItem Content="Raw Text Envelope (.txt)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Schema Metadata Preview Tag -->
                        <Border Grid.Row="1" Background="#141E2B" BorderBrush="#223B59" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Transfer Magic: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="STXM (0x5354584D)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Schema: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="v21 Validated" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,12,0"/>
                                    <TextBlock Text="Hash: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="FNV-1a Envelope Checksum" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981"/>
                                </StackPanel>
                                <TextBlock Text="SourceTX Transfer Contract" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- SOURCETX_MODEL Preview Box -->
                        <Border Grid.Row="2" 
                                Background="#0A0C10" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8" 
                                MinHeight="75"
                                Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ExportPreviewBlock" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="10" 
                                           Foreground="#85E89D" 
                                           TextWrapping="Wrap" 
                                           Text="SOURCETX_MODEL:4D5854531500C401...[HEX_PAYLOAD_STXM_SCHEMA_21]...8A7E4F21" />
                            </ScrollViewer>
                        </Border>

                        <!-- Export Action Button -->
                        <Button Grid.Row="3" 
                                Style="{StaticResource ModernAccentButton}" 
                                Background="{DynamicResource SuccessBrush}"
                                Height="34" 
                                HorizontalAlignment="Right" 
                                Click="ExecuteExport_Click">
                            <TextBlock Text="💾 Generate &amp; Save Model File" FontWeight="Bold" FontSize="11.5" Foreground="#0A0C10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW F: IMPORT PANEL                   -->
            <!-- ====================================== -->
            <Grid x:Name="ImportView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}" 
                            HorizontalAlignment="Left" 
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Import Model Memory Restore (SOURCETX_MODEL)" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Import Content Deck -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- File Picker -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Select SourceTX Model Backup File (.stx / .txt)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ImportPathBox" 
                                         Text="Crawler_4x4_MOA_backup.stx (SOURCETX_MODEL: STXM Envelope)" 
                                         Height="32" 
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" 
                                        Style="{StaticResource ModernOutlineButton}" 
                                        Height="32" 
                                        Click="BrowseImport_Click">
                                    <TextBlock Text="Browse File..." FontWeight="Medium" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Target Destination Slot & Validation Status -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Destination Slot" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ImportTargetSlotComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="Slot 01 (Overwrite current model)" />
                                    <ComboBoxItem Content="Slot 02 (Empty)" />
                                    <ComboBoxItem Content="Slot 03 (Empty)" />
                                    <ComboBoxItem Content="Slot 04 (Empty)" />
                                    <ComboBoxItem Content="Slot 05 (Empty)" />
                                </ComboBox>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#261E14" BorderBrush="#594324" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Bottom" Height="32">
                                <Grid VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Validation: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ImportValidationTag" Text="STXM Magic • Schema 21 • FNV-1a Checksum OK" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Validation Inspector Box -->
                        <Border Grid.Row="2" 
                                Background="#0A0C10" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8" 
                                MinHeight="75"
                                Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ImportLogBlock" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="10" 
                                           Foreground="#FBBF24" 
                                           TextWrapping="Wrap" 
                                           Text="[VALIDATOR] Ready to inspect SOURCETX_MODEL: file.&#x0a;[VALIDATOR] Contract: Magic 0x5354584D ('STXM') | Schema Version 21 | Exact ModelConfig payload size.&#x0a;[VALIDATOR] Select file to verify binary envelope header and checksum." />
                            </ScrollViewer>
                        </Border>

                        <!-- Import Action Button -->
                        <Button Grid.Row="3" 
                                Style="{StaticResource ModernAccentButton}" 
                                Background="{DynamicResource WarningBrush}"
                                Height="34" 
                                HorizontalAlignment="Right" 
                                Click="ExecuteImport_Click">
                            <TextBlock Text="⚡ Validate &amp; Prepare Model Restore" FontWeight="Bold" FontSize="11.5" Foreground="#0A0C10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. BOTTOM STATUS BAR WITH REPORT & UPDATES -->
        <!-- ========================================== -->
        <Border Grid.Row="2" 
                Background="{DynamicResource FooterBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,0,12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Pill Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicatorDot" Width="7.5" Height="7.5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusBarText" Text="Ready • SourceTX Companion v0.1.2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Hardware Tag Center-Right -->
                <TextBlock x:Name="StatusHardwareTag" 
                           Grid.Column="2" 
                           Text="ESP32-S3-FH4R2 • 4MB Flash • 2MB PSRAM • ST7796U" 
                           FontSize="10.5" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           VerticalAlignment="Center"/>

                <!-- Theme Toggle Switch Button -->
                <Button x:Name="ThemeToggleButton" 
                        Grid.Column="4" 
                        Style="{StaticResource SmallBugButton}" 
                        Click="ToggleTheme_Click" 
                        ToolTip="Switch between Dark and Light application themes">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeToggleText" Text="Theme: 🌙 Dark" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Check for Updates Button Bottom -->
                <Button Grid.Column="6" 
                        Style="{StaticResource SmallBugButton}" 
                        Click="CheckForUpdates_Click" 
                        ToolTip="Check for latest SourceTX Companion and firmware updates">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔄 Check for Updates" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bug Report Button Bottom Right -->
                <Button Grid.Column="8" 
                        Style="{StaticResource SmallBugButton}" 
                        Click="ReportBug_Click" 
                        ToolTip="Open GitHub Issues to report a bug or suggest an improvement">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 9 2 C 7.34 2 6 3.34 6 5 L 6 7 C 4.34 7 3 8.34 3 10 L 3 14 C 3 15.66 4.34 17 6 17 L 6 19 C 6 20.66 7.34 22 9 22 L 15 22 C 16.66 22 18 20.66 18 19 L 18 17 C 19.66 17 21 15.66 21 14 L 21 10 C 21 8.34 19.66 7 18 7 L 18 5 C 18 3.34 16.66 2 15 2 L 9 2 Z M 8 6 L 16 6 L 16 7 L 8 7 Z M 5 10 L 19 10 L 19 14 L 5 14 Z M 8 17 L 16 17 L 16 20 L 8 20 Z" 
                              Fill="{DynamicResource TextSecondaryBrush}" 
                              Width="10" Height="10" 
                              Stretch="Uniform" 
                              Margin="0,0,5,0" 
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Report a Bug" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
