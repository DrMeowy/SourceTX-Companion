<Window x:Class="SourceTXCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SourceTX Companion"
        Height="580" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" /> <!-- Custom Title Bar -->
            <RowDefinition Height="*" />  <!-- Main Content Views -->
            <RowDefinition Height="34" /> <!-- Bottom Status Bar with Bug Report -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. CUSTOM TITLE BAR                        -->
        <!-- ========================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0,8,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M 12 3 L 20 8 L 20 16 L 12 21 L 4 16 L 4 8 Z"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="SourceTX" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" Companion" FontWeight="Normal" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v0.1.5" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Minimize & Close only, Fixed Size) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlBtn}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Data="M 0 0 L 10 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="2" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseBtn}" Click="CloseButton_Click" ToolTip="Close">
                        <Path Data="M 0 0 L 9 9 M 0 9 L 9 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="9" Height="9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. MAIN CONTENT AREA (VIEWS)               -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="22,12,22,10">

            <!-- ====================================== -->
            <!-- VIEW A: HOME DASHBOARD                 -->
            <!-- ====================================== -->
            <Grid x:Name="HomeView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero Section Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <TextBlock Text="SourceTX Companion"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Install, update, and back up your SourceTX transmitter"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Four available actions plus one in-development placeholder -->
                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 1: INSTALL, UPDATE, AND CONFIGURE -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- BUTTON 1: INSTALL (Factory Build Installation) -->
                        <Button Grid.Column="0"
                                Style="{StaticResource ActionCardBtn}"
                                Click="NavToInstall_Click"
                                MinHeight="185">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Width="40" Height="40"
                                        CornerRadius="10"
                                        Background="{DynamicResource CardInstallBgBrush}"
                                        BorderBrush="{DynamicResource CardInstallBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8">
                                    <Path Data="M 12 2 L 15 8 L 22 9 L 17 14 L 18 21 L 12 17 L 6 21 L 7 14 L 2 9 L 9 8 Z"
                                          Stroke="{DynamicResource CardInstallAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Install SourceTX"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="For a new or fully erased board"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource CardInstallAccentBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="Set up a supported ESP32-S3 board with verified stable SourceTX firmware. The app checks the board before writing anything."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Margin="0,0,0,8"/>

                                <Border Grid.Row="3"
                                        Background="{DynamicResource CardInstallPillBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Set Up a New Board"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CardInstallAccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="→"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource CardInstallAccentBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- BUTTON 2: UPDATE OR REPAIR -->
                        <Button Grid.Column="2"
                                Style="{StaticResource ActionCardBtn}"
                                Click="NavToUpdate_Click"
                                MinHeight="185">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Width="40" Height="40"
                                        CornerRadius="10"
                                        Background="{DynamicResource CardUpdateBgBrush}"
                                        BorderBrush="{DynamicResource CardUpdateBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8">
                                    <Path Data="M 12 3 L 12 15 M 7 10 L 12 15 L 17 10 M 4 19 L 20 19"
                                          Stroke="{DynamicResource CardUpdateAccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Update or Repair"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="For an existing SourceTX transmitter"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource CardUpdateAccentBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="Install the stable firmware included with this Companion. A regular update keeps your saved models and settings."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Margin="0,0,0,8"/>

                                <Border Grid.Row="3"
                                        Background="{DynamicResource CardUpdatePillBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Update SourceTX"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CardUpdateAccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="→"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource CardUpdateAccentBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- BUTTON 3: CONFIGURE TRANSMITTER -->
                        <Button Grid.Column="4"
                                Style="{StaticResource ActionCardBtn}"
                                Click="NavToConfig_Click"
                                MinHeight="185">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Border Width="40" Height="40"
                                            CornerRadius="10"
                                            Background="{DynamicResource CardConfigBgBrush}"
                                            BorderBrush="{DynamicResource CardConfigBorderBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left">
                                        <Path Data="M 4 6 L 9 6 M 15 6 L 20 6 M 12 3 L 12 9 M 4 12 L 13 12 M 17 12 L 20 12 M 15 9 L 15 15 M 4 18 L 7 18 M 11 18 L 20 18 M 9 15 L 9 21"
                                              Stroke="{DynamicResource CardConfigAccentBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="17" Height="17"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardInnerBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="NVS PINS"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CardConfigAccentBrush}" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock Text="Configure Transmitter"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Hardware pins &amp; feedback"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CardConfigAccentBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="Set up your CRSF UART pin, status LED indicators, and audio/haptic pins directly in NVS without re-flashing."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Margin="0,0,0,8"/>

                                <Border Grid.Row="3"
                                        Background="{DynamicResource CardConfigPillBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Configure Pins"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CardConfigAccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="→"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource CardConfigAccentBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                    </Grid>

                    <!-- ROW 2: EXPORT, IMPORT (2 Columns) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- BUTTON 4: EXPORT -->
                        <Button Grid.Column="0"
                                Style="{StaticResource ActionCardBtn}"
                                Click="NavToExport_Click"
                                MinHeight="136"
                                Padding="18,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardExportBgBrush}" BorderBrush="{DynamicResource CardExportBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="M 12 15 L 12 3 M 7 8 L 12 3 L 17 8 M 4 19 L 20 19"
                                                  Stroke="{DynamicResource CardExportAccentBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Back Up Models" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Save one model or all model slots" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CardExportAccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="Save your current model or every configured model to a backup file. Backups are checked for corruption before they are saved."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Margin="0,0,0,6"/>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource CardExportPillBrush}"
                                        CornerRadius="5"
                                        Padding="10,5"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Create a Backup" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CardExportAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="→" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CardExportAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- BUTTON 5: IMPORT -->
                        <Button Grid.Column="2"
                                Style="{StaticResource ActionCardBtn}"
                                Click="NavToImport_Click"
                                MinHeight="136"
                                Padding="18,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource CardImportBgBrush}" BorderBrush="{DynamicResource CardImportBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="M 4 4 L 4 14 C 4 17 20 17 20 14 L 20 4 M 12 4 L 12 12 M 8 8 L 12 12 L 16 8"
                                                  Stroke="{DynamicResource CardImportAccentBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Restore Models" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Recover models from a backup" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CardImportAccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="Choose a SourceTX backup, verify it, and restore it to your transmitter. You will be warned before any model is overwritten."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Margin="0,0,0,6"/>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource CardImportPillBrush}"
                                        CornerRadius="5"
                                        Padding="10,5"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="Choose a Backup" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CardImportAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="→" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CardImportAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW B: INSTALL (FACTORY INSTALLATION) -->
            <!-- ====================================== -->
            <Grid x:Name="InstallView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ModernOutlineButton}"
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Install SourceTX on a New Board" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="For blank boards or a completely fresh installation" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Release channel" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Button Style="{StaticResource ModernAccentButton}" Padding="10,5" IsHitTestVisible="False" Focusable="False" ToolTip="Stable releases are tested and recommended for normal use">
                            <TextBlock Text="Stable" FontSize="10.5" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource ModernOutlineButton}" Padding="10,5" Margin="6,0,0,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Coming later — no experimental releases are available yet">
                            <TextBlock Text="Experimental" FontSize="10.5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Install Content Deck -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Supported hardware and USB connection -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Supported hardware" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <Border Height="32" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,0">
                                    <TextBlock Text="SourceTX reference transmitter — ESP32-S3, 4 MB, 3.5-inch touch display" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Transmitter USB connection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="InstallPortComboBox" Height="32" />
                            </StackPanel>

                            <Button Grid.Column="4"
                                    Style="{StaticResource ModernOutlineButton}"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Click="AutoDetectPorts_Click"
                                    ToolTip="Find a connected SourceTX board">
                                <TextBlock Text="Find Transmitter" FontWeight="SemiBold" FontSize="11" />
                            </Button>

                            <ComboBox x:Name="InstallBoardComboBox" Visibility="Collapsed" SelectionChanged="HardwareTarget_Changed" />
                            <ComboBox x:Name="InstallDisplayComboBox" Visibility="Collapsed" SelectionChanged="HardwareTarget_Changed" />
                        </Grid>

                        <!-- Dynamic Board Specs & Pinout Info Card -->
                        <Border Grid.Row="1" Background="{DynamicResource NoticeBannerBgBrush}" BorderBrush="{DynamicResource NoticeBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="InstallSpecsBlock" Text="Verified hardware profile: SourceTX ESP32-S3 reference transmitter" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="InstallPinoutBlock" Text="The board, flash memory, display, and touch controller are checked before installation." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="InstallTargetStatusBadge" Background="#1B3324" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstallTargetStatusText" Text="Supported" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Stable package and data-erasure choice -->
                        <Border Grid.Row="2" Background="{DynamicResource NoticeBannerBgBrush}" BorderBrush="{DynamicResource NoticeBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Verified stable firmware" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Companion downloads the signed release and checks it before installation. Keep the USB cable connected until completion." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,14,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <CheckBox x:Name="EraseChipCheckBox" IsChecked="False" Content="Erase all saved settings and models" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="Leave this off unless you want a completely clean start." FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Progress Bar & Status -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <TextBlock x:Name="InstallStatusText" Text="Ready — connect the board and choose Find Transmitter" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InstallPercentText" Text="0%" FontSize="10.5" FontWeight="SemiBold" Foreground="#C084FC" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="InstallProgressBar" Value="0" Maximum="100" Height="5" Foreground="#C084FC" />
                        </StackPanel>

                        <!-- Optional troubleshooting details -->
                        <Expander Grid.Row="4" Header="Technical details (only needed for troubleshooting)" IsExpanded="False" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                            <Border Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Height="105" Margin="0,5,0,0">
                                <ScrollViewer x:Name="InstallLogScroll" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="InstallConsoleLogBlock"
                                               FontFamily="Consolas, Courier New, monospace"
                                               FontSize="10"
                                               Foreground="#C084FC"
                                               TextWrapping="Wrap"
                                               Text="[READY] Connect the board by USB, choose Find Transmitter, then Install SourceTX." />
                                </ScrollViewer>
                            </Border>
                        </Expander>

                        <!-- Install Action Button -->
                        <Button Grid.Row="5"
                                x:Name="RunInstallButton"
                                Style="{StaticResource ModernAccentButton}"
                                Background="#9333EA"
                                Height="34"
                                HorizontalAlignment="Right"
                                Click="StartInstall_Click">
                            <TextBlock Text="Install SourceTX" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW C: UPDATE / FIRMWARE PANEL        -->
            <!-- ====================================== -->
            <Grid x:Name="UpdateView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ModernOutlineButton}"
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Update or Repair SourceTX" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Regular Update is recommended and keeps your models and settings" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Release channel" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Button Style="{StaticResource ModernAccentButton}" Padding="10,5" IsHitTestVisible="False" Focusable="False" ToolTip="Stable releases are tested and recommended for normal use">
                            <TextBlock Text="Stable" FontSize="10.5" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource ModernOutlineButton}" Padding="10,5" Margin="6,0,0,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Coming later — no experimental releases are available yet">
                            <TextBlock Text="Experimental" FontSize="10.5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Update Content Deck -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Update type and USB connection -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="What do you want to do?" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="FlashModeComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="Regular update — keep models and settings" />
                                    <ComboBoxItem Content="Recovery install — reinstall all firmware" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Transmitter USB connection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="PortComboBox" Height="32" />
                            </StackPanel>

                            <Button Grid.Column="4"
                                    Style="{StaticResource ModernOutlineButton}"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Click="AutoDetectPorts_Click"
                                    ToolTip="Find a connected SourceTX transmitter">
                                <TextBlock Text="Find Transmitter" FontWeight="SemiBold" FontSize="11" />
                            </Button>

                            <ComboBox x:Name="UpdateBoardComboBox" Visibility="Collapsed" SelectionChanged="HardwareTarget_Changed" />
                            <ComboBox x:Name="UpdateDisplayComboBox" Visibility="Collapsed" SelectionChanged="HardwareTarget_Changed" />
                        </Grid>

                        <!-- Included stable firmware notice -->
                        <Border Grid.Row="1" Background="{DynamicResource NoticeBannerBgBrush}" BorderBrush="{DynamicResource NoticeBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Stable firmware included with Companion" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Regular Update changes only the SourceTX application and keeps compatible models and settings. Recovery Install rewrites the complete boot and application firmware." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Progress Bar & Status -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <TextBlock x:Name="FlashStatusText" Text="Ready — connect the transmitter and choose Find Transmitter" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="FlashPercentText" Text="0%" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="FlashProgressBar" Value="0" Maximum="100" Height="5" />
                        </StackPanel>

                        <!-- Optional troubleshooting details -->
                        <Expander Grid.Row="3" Header="Technical details (only needed for troubleshooting)" IsExpanded="False" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                            <Border Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Height="105" Margin="0,5,0,0">
                                <ScrollViewer x:Name="FlashLogScroll" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ConsoleLogBlock"
                                               FontFamily="Consolas, Courier New, monospace"
                                               FontSize="10"
                                               Foreground="#85E89D"
                                               TextWrapping="Wrap"
                                               Text="[READY] Connect the transmitter by USB, choose Find Transmitter, then Update SourceTX." />
                                </ScrollViewer>
                            </Border>
                        </Expander>

                        <!-- Flash Action Button -->
                        <Button Grid.Row="4"
                                x:Name="FlashButton"
                                Style="{StaticResource ModernAccentButton}"
                                Height="34"
                                HorizontalAlignment="Right"
                                Click="StartFlash_Click">
                            <TextBlock Text="Update SourceTX" FontWeight="Bold" FontSize="11.5" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>


            <!-- ====================================== -->
            <!-- VIEW E: EXPORT PANEL                   -->
            <!-- ====================================== -->
            <Grid x:Name="ExportView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}"
                            HorizontalAlignment="Left"
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Back Up Models"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Export Content Deck -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Backup choice and USB connection -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="What do you want to back up?" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ExportScopeComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="Current model" />
                                    <ComboBoxItem Content="All models — recommended complete backup" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Transmitter USB connection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ExportPortComboBox" Height="32" />
                            </StackPanel>

                            <Button Grid.Column="4" Style="{StaticResource ModernOutlineButton}" Height="32" VerticalAlignment="Bottom" Click="AutoDetectPorts_Click">
                                <TextBlock Text="Find Transmitter" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- Backup integrity notice -->
                        <Border Grid.Row="1" Background="{DynamicResource NoticeBannerBgBrush}" BorderBrush="{DynamicResource NoticeBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,6">
                                <TextBlock Text="Backups are checked before saving. If All Models is unavailable, update the transmitter or back up the current model instead." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- SOURCETX_MODEL Preview Box -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource ConsoleBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                MinHeight="75"
                                Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ExportPreviewBlock"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="10"
                                           Foreground="#85E89D"
                                           TextWrapping="Wrap"
                                           Text="1. Connect the transmitter and open Settings → Transmitter → Model Transfer.&#x0a;2. Choose Current Model or All Models above.&#x0a;3. For Current Model, choose Create Backup here and then press Export To USB Serial on the transmitter." />
                            </ScrollViewer>
                        </Border>

                        <!-- Export Action Button -->
                        <Button x:Name="ExecuteExportButton" Grid.Row="3"
                                Style="{StaticResource ModernAccentButton}"
                                Background="{DynamicResource SuccessBrush}"
                                Height="34"
                                HorizontalAlignment="Right"
                                Click="ExecuteExport_Click">
                            <TextBlock Text="Create Backup" FontWeight="Bold" FontSize="11.5" Foreground="#0A0C10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW F: IMPORT PANEL                   -->
            <!-- ====================================== -->
            <Grid x:Name="ImportView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ModernOutlineButton}"
                            HorizontalAlignment="Left"
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <TextBlock Text="Restore Models"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Import Content Deck -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- File Picker -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Backup file" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ImportPathBox"
                                         Text=""
                                         Height="32"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource ModernOutlineButton}"
                                        Height="32"
                                        Click="BrowseImport_Click">
                                    <TextBlock Text="Choose Backup..." FontWeight="Medium" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Target Destination Slot & Validation Status -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Restore to" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ImportTargetSlotComboBox" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="Current model (most compatible)" />
                                    <ComboBoxItem Content="Slot 01" />
                                    <ComboBoxItem Content="Slot 02" />
                                    <ComboBoxItem Content="Slot 03" />
                                    <ComboBoxItem Content="Slot 04" />
                                    <ComboBoxItem Content="Slot 05" />
                                    <ComboBoxItem Content="Slot 06" />
                                    <ComboBoxItem Content="Slot 07" />
                                    <ComboBoxItem Content="Slot 08" />
                                    <ComboBoxItem Content="Slot 09" />
                                    <ComboBoxItem Content="Slot 10" />
                                    <ComboBoxItem Content="Slot 11" />
                                    <ComboBoxItem Content="Slot 12" />
                                    <ComboBoxItem Content="Slot 13" />
                                    <ComboBoxItem Content="Slot 14" />
                                    <ComboBoxItem Content="Slot 15" />
                                    <ComboBoxItem Content="Slot 16" />
                                    <ComboBoxItem Content="Slot 17" />
                                    <ComboBoxItem Content="Slot 18" />
                                    <ComboBoxItem Content="Slot 19" />
                                    <ComboBoxItem Content="Slot 20" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Transmitter USB connection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ImportPortComboBox" Height="32" />
                            </StackPanel>

                            <Border Grid.Column="4" Background="{DynamicResource NoticeBannerBgBrush}" BorderBrush="{DynamicResource NoticeBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Bottom" Height="32">
                                <Grid VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="File check: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ImportValidationTag" Text="Select a backup file" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Validation Inspector Box -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource ConsoleBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                MinHeight="75"
                                Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ImportLogBlock"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="10"
                                           Foreground="#FBBF24"
                                           TextWrapping="Wrap"
                                           Text="Choose a SourceTX backup file. Companion will check it before enabling the restore.&#x0a;&#x0a;Tip: Current Model is the most compatible restore option." />
                            </ScrollViewer>
                        </Border>

                        <!-- Import Action Button -->
                        <Button x:Name="ExecuteImportButton" Grid.Row="3"
                                Style="{StaticResource ModernAccentButton}"
                                Background="{DynamicResource WarningBrush}"
                                Height="34"
                                HorizontalAlignment="Right"
                                Click="ExecuteImport_Click">
                            <TextBlock Text="Restore Models" FontWeight="Bold" FontSize="11.5" Foreground="#0A0C10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================== -->
            <!-- VIEW G: CONFIGURE HARDWARE PINS PANEL  -->
            <!-- ====================================== -->
            <Grid x:Name="ConfigView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ModernOutlineButton}"
                            Click="NavToHome_Click">
                        <TextBlock Text="← Back to Main Menu" FontWeight="SemiBold" FontSize="11.5" />
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Configure Transmitter Hardware Pins" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Save CRSF UART, Status LED, and Feedback pins directly in NVS memory" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Config Content Deck -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar: USB Connection + Read Action -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Transmitter USB connection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ConfigPortComboBox" Height="32" />
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource ModernOutlineButton}" Height="32" VerticalAlignment="Bottom" Click="AutoDetectPorts_Click">
                                <TextBlock Text="Find Transmitter" FontSize="11" />
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource ModernAccentButton}" Background="{DynamicResource CardConfigAccentBrush}" Height="32" VerticalAlignment="Bottom" Click="ReadConfig_Click">
                                <TextBlock Text="📥 Read from Transmitter" FontWeight="Bold" FontSize="11" Foreground="#0A0C10" />
                            </Button>
                        </Grid>

                        <!-- Notice Banner -->
                        <Border Grid.Row="1" Background="{DynamicResource NoticeBannerBgBrush}" BorderBrush="{DynamicResource NoticeBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,8">
                            <TextBlock Text="Tip: Open Settings → Transmitter → Model Transfer on the transmitter, then click Read from Transmitter or Save to Transmitter." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Pin Configuration Cards Deck (3 Subsystems) -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CARD 1: CRSF RADIO UART -->
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource CardInstallBgBrush}" BorderBrush="{DynamicResource CardInstallBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock Text="📡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CRSF Radio UART" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="ExpressLRS / Crossfire" FontSize="9" Foreground="{DynamicResource CardInstallAccentBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="CRSF Half-Duplex Pin" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                                    <ComboBox x:Name="CrsfPinComboBox" Height="30" Margin="0,0,0,6"/>

                                    <TextBlock Text="Half-duplex serial pin for internal or external RF module (default: GPIO 43)." FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="13"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: STATUS INDICATOR LED -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource CardConfigBgBrush}" BorderBrush="{DynamicResource CardConfigBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock Text="💡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Status Indicator LED" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Visual transmitter status" FontSize="9" Foreground="{DynamicResource CardConfigAccentBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Indicator Mode" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                    <ComboBox x:Name="StatusModeComboBox" Height="28" Margin="0,0,0,4" SelectionChanged="StatusMode_SelectionChanged">
                                        <ComboBoxItem Content="Disabled" />
                                        <ComboBoxItem Content="Mono Single-Color LED" />
                                        <ComboBoxItem Content="RGB LED (3-Pin PWM)" />
                                        <ComboBoxItem Content="Addressable RGB (WS2812 / 1-Pin)" />
                                    </ComboBox>

                                    <StackPanel x:Name="StatusMonoPinPanel">
                                        <TextBlock x:Name="StatusMonoPinLabel" Text="Mono LED Pin" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,1"/>
                                        <ComboBox x:Name="StatusMonoPinComboBox" Height="26" Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <StackPanel x:Name="StatusRgbPinsPanel" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Red" FontSize="9.5" FontWeight="SemiBold" Foreground="#F87171"/>
                                                <ComboBox x:Name="StatusRedPinComboBox" Height="26"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Green" FontSize="9.5" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                <ComboBox x:Name="StatusGreenPinComboBox" Height="26"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Blue" FontSize="9.5" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                                <ComboBox x:Name="StatusBluePinComboBox" Height="26"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="Brightness" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="StatusBrightnessText" Text="60%" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CardConfigAccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="StatusBrightnessSlider" Minimum="0" Maximum="100" Value="60" ValueChanged="StatusBrightness_ValueChanged" Height="20" SmallChange="5" LargeChange="10"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: AUDIO & HAPTICS -->
                            <Border Grid.Column="4" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource CardExportBgBrush}" BorderBrush="{DynamicResource CardExportBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock Text="🔊" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Audio &amp; Haptics" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Buzzer, voice &amp; vibration" FontSize="9" Foreground="{DynamicResource CardExportAccentBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Sound Output Mode" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                    <ComboBox x:Name="SoundModeComboBox" Height="28" Margin="0,0,0,4">
                                        <ComboBoxItem Content="Disabled" />
                                        <ComboBoxItem Content="Tone Buzzer (PWM)" />
                                        <ComboBoxItem Content="DFPlayer Mini (Voice)" />
                                    </ComboBox>

                                    <TextBlock Text="Sound / Buzzer Pin" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,1"/>
                                    <ComboBox x:Name="SoundPinComboBox" Height="26" Margin="0,0,0,4"/>

                                    <TextBlock Text="Vibration Motor Pin" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,1"/>
                                    <ComboBox x:Name="VibrationPinComboBox" Height="26" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Log Console Block -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource ConsoleBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                MinHeight="65"
                                Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ConfigLogBlock"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="10"
                                           Foreground="{DynamicResource CardConfigAccentBrush}"
                                           TextWrapping="Wrap"
                                           Text="[READY] Connect transmitter via USB and open Settings → Transmitter → Model Transfer.&#x0a;Click 'Read from Transmitter' to inspect saved NVS pins, or adjust and click 'Save to Transmitter'." />
                            </ScrollViewer>
                        </Border>

                        <!-- Save Action Button -->
                        <Button x:Name="SaveConfigButton" Grid.Row="4"
                                Style="{StaticResource ModernAccentButton}"
                                Background="{DynamicResource CardConfigAccentBrush}"
                                Height="34"
                                HorizontalAlignment="Right"
                                Click="SaveConfig_Click">
                            <TextBlock Text="💾 Save to Transmitter (NVS)" FontWeight="Bold" FontSize="11.5" Foreground="#0A0C10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. BOTTOM STATUS BAR WITH REPORT & UPDATES -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0,12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Pill Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicatorDot" Width="7.5" Height="7.5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusBarText" Text="Ready • SourceTX Companion v0.1.5" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Theme Toggle Switch Button -->
                <Button x:Name="ThemeToggleButton"
                        Grid.Column="2"
                        Style="{StaticResource SmallBugButton}"
                        Click="ToggleTheme_Click"
                        ToolTip="Switch between Dark and Light application themes">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeToggleText" Text="Theme: 🌙 Dark" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Check for Updates Button Bottom -->
                <Button Grid.Column="4"
                        Style="{StaticResource SmallBugButton}"
                        Click="CheckForUpdates_Click"
                        ToolTip="Check for a newer version of SourceTX Companion">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Check for App Updates" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bug Report Button Bottom Right -->
                <Button Grid.Column="6"
                        Style="{StaticResource SmallBugButton}"
                        Click="ReportBug_Click"
                        ToolTip="Open GitHub Issues to report a bug or suggest an improvement">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 9 2 C 7.34 2 6 3.34 6 5 L 6 7 C 4.34 7 3 8.34 3 10 L 3 14 C 3 15.66 4.34 17 6 17 L 6 19 C 6 20.66 7.34 22 9 22 L 15 22 C 16.66 22 18 20.66 18 19 L 18 17 C 19.66 17 21 15.66 21 14 L 21 10 C 21 8.34 19.66 7 18 7 L 18 5 C 18 3.34 16.66 2 15 2 L 9 2 Z M 8 6 L 16 6 L 16 7 L 8 7 Z M 5 10 L 19 10 L 19 14 L 5 14 Z M 8 17 L 16 17 L 16 20 L 8 20 Z"
                              Fill="{DynamicResource DangerBrush}"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Report a Bug" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
